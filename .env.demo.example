# คัดลอกเป็น .env.demo แล้วเติมค่าจริง — .env.demo ถูก gitignore ห้าม commit
# รัน: make demo-up

# --- tunnel (Cloudflare Zero Trust > Networks > Tunnels > Create remotely-managed) ---
# public hostname ของ tunnel ต้องชี้ service: http://demo:8080
TUNNEL_TOKEN=
# URL ถาวรของ tunnel เช่น https://ocpi-demo.your-domain.com
PUBLIC_BASE_URL=

# --- Evolt dev (internal hostnames — ขอจากทีม, เครื่องต้องต่อ VPN) ---
EVOLT_VERSIONS_URL=http://<bff-host>/api/ocpi/versions
EVOLT_ORCH_URL=http://<orch-host>
EVOLT_ADAPTER_URL=http://<adapter-host>
EVOLT_ROAMING_URL=http://<roaming-host>
# core-auth: resolves the credentials_id Evolt filed this partner under (the mirror panel reads it)
EVOLT_COREAUTH_URL=http://<core-auth-host>
EVOLT_ORCH_API_KEY=
EVOLT_ROAMING_API_KEY=

# --- ปุ่ม Evolt→partner tariff push ยิงได้เฉพาะ station เหล่านี้ (csv) ---
DEMO_ALLOWED_STATION_IDS=

# --- Kafka evse-status demo (ปิดอัตโนมัติถ้าค่าไม่ครบ/broker ไม่ถึง) ---
DEMO_ENABLE_KAFKA=true
DEMO_KAFKA_BROKER=<redpanda-host>:9094
# นอกคลัสเตอร์ทุก hostname ชี้ LB เดียวที่ตกลงที่ broker แรก จึงเขียนได้เฉพาะ partition
# ที่ broker นั้นเป็น leader — ต่างกันตาม topic (evse_status = p0) เช็คด้วย MetadataRequest
# ถ้าตั้งผิด ปุ่มจะปิดตัวเองพร้อมเหตุผลตอน start ไม่ใช่ error ตอนกด
DEMO_KAFKA_PARTITION=0
DEMO_KAFKA_STATION_ID=
# evses.uid — goes in the Kafka event payload
DEMO_KAFKA_EVSE_UID=
DEMO_KAFKA_EVSE_ID=
# the uid Evolt puts in the OCPI PATCH path (evses.evse_id, numeric) — read it off a real pull:
# evses[].uid in GET /ocpi/cpo/2.2.1/locations, NOT evses[].evse_id
DEMO_KAFKA_OCPI_EVSE_UID=
# the party Evolt PATCHes as (cfg OCPI party of core-ocpi-roaming) — the PATCH baseline is filed
# under it; a wrong value answers every status event with 2003
DEMO_KAFKA_PARTY_CC=TH
DEMO_KAFKA_PARTY_ID=EVO

# --- Roaming Out cron buttons (batch-ocpi-process) ---
# Build the binaries first:  make batch-jobs   (BATCH_SRC=../batch-ocpi-process by default)
# AES-256 hex key the job uses to decrypt the partner's outbound token. It must be the same key
# orch-ocpi encrypted it with, or every partner fails to decrypt. Never a real key in this file.
BATCH_TOKEN_ENCRYPTION_KEY=
# APP_ENV handed to the job — picks config/env/config.<env>.yaml
BATCH_APP_ENV=dev
